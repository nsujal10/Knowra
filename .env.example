# API Configuration
PROJECT_NAME="Enterprise Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production"

# PostgreSQL
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="enterprise_ai"
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/enterprise_ai"

# Redis
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3
S3_ENDPOINT="localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="enterprise-media"
S3_SECURE=False

# LLM Provider
LLM_PROVIDER="openai"
LLM_API_KEY="sk-..."
LLM_MODEL="gpt-4o-mini"

# Embedding Provider
EMBEDDING_PROVIDER="sentence_transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384

# Worker Configuration
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
ASR_COMPUTE_TYPE="int8" # float16 for GPU
ASR_DEVICE="cpu" # cuda for GPU

# Enterprise Single Sign-On (Google & Microsoft Entra ID OIDC)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

MICROSOFT_CLIENT_ID="your-microsoft-app-client-id-uuid"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret-value"
MICROSOFT_TENANT_ID="common" # "common", "organizations", or specific tenant UUID

OAUTH_REDIRECT_BASE_URL="http://localhost:8000/api/v1/auth"
FRONTEND_URL="http://localhost:3000"
SSO_ENFORCE_BUSINESS_DOMAINS=False # Set to True in production to reject personal email domains (@gmail, @outlook)
# Slack Enterprise App Integration (OAuth 2.0 / Webhook / Bot Token)
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_SIGNING_SECRET="your-slack-signing-secret"
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
SLACK_DEFAULT_CHANNEL="#general-intelligence"

# Atlassian Jira Software Integration (OAuth 2.0 / API Token)
JIRA_CLIENT_ID="your-atlassian-app-client-id"
JIRA_CLIENT_SECRET="your-atlassian-app-secret"
JIRA_INSTANCE_URL="https://your-domain.atlassian.net"
JIRA_API_EMAIL="user@company.com"
JIRA_API_TOKEN="your-atlassian-api-token"
JIRA_DEFAULT_PROJECT_KEY="SCRUM"
