# API Configuration
PROJECT_NAME="Enterprise Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production"

# PostgreSQL
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="enterprise_ai"
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/enterprise_ai"

# Redis
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3
S3_ENDPOINT="localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="enterprise-media"
S3_SECURE=False

# LLM Provider
LLM_PROVIDER="openai"
LLM_API_KEY="sk-..."
LLM_MODEL="gpt-4o-mini"

# Embedding Provider
EMBEDDING_PROVIDER="sentence_transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384

# Worker Configuration
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
ASR_COMPUTE_TYPE="int8" # float16 for GPU
ASR_DEVICE="cpu" # cuda for GPU
